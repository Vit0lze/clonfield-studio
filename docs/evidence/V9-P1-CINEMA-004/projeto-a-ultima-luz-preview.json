  "audio": {
   "voice": [
    {
     "src": "v_65971e9c50572b13",
     "at": 4.0,
     "note": "Meu pai acendia o farol todo fim de tarde."
    },
    {
     "src": "v_5a8ad40674480040",
     "at": 10.0,
     "note": "Ele dizia que a luz não era para quem chega. Era para quem ainda está no mar."
    },
    {
     "src": "v_cceb989d343b4116",
     "at": 17.0,
     "note": "Eu achava que era só uma lâmpada, girando."
    },
    {
     "src": "v_974fcd901d67a25c",
     "at": 26.5,
     "note": "Hoje a cidade acende sozinha. Ninguém mais sobe a escada."
    },
    {
     "src": "v_c1db07458a7e168c",
     "at": 45.5,
     "note": "Mas toda tarde, eu ainda olho para o mar."
    }
   ]
  }
 },
